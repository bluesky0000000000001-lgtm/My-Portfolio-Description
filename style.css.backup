
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #080b16;
    color: #f1f5ff;
    font-family: Arial, sans-serif;
    line-height: 1.7;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 7%;
    border-bottom: 1px solid #24324b;
    background: #080b16;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    color: white;
    font-size: 21px;
    font-weight: bold;
    text-decoration: none;
}

.logo span,
.hero span {
    color: #00c8ff;
}

.nav-links {
    display: flex;
    gap: 20px;
}

.nav-links a {
    color: #c4cee0;
    text-decoration: none;
}

.nav-links a:hover {
    color: #00c8ff;
}

.menu-toggle {
    display: none;
}

.hero {
    min-height: 75vh;
    padding: 100px 8%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: radial-gradient(
        circle at 80% 40%,
        #172e56 0%,
        #080b16 55%
    );
}

.tag {
    color: #00c8ff;
    letter-spacing: 3px;
    font-size: 12px;
}

.hero h1 {
    font-size: clamp(38px, 8vw, 70px);
    line-height: 1.2;
    margin: 20px 0;
}

.intro {
    color: #aab7cd;
    max-width: 550px;
    margin-bottom: 28px;
}

.btn {
    display: inline-block;
    background: #00bfff;
    color: #07101c;
    padding: 12px 22px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: bold;
    width: fit-content;
}

.section {
    padding: 70px 8%;
    scroll-margin-top: 85px;
}

.section h2 {
    color: #00c8ff;
    font-size: 30px;
    margin: 10px 0 20px;
}

.section p {
    color: #aab7cd;
}

.grid {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(220px, 1fr)
    );
    gap: 20px;
    margin-top: 25px;
}

.project-card {
    background: #111a2b;
    border: 1px solid #243b5a;
    border-radius: 12px;
    padding: 23px;
    transition: 0.3s;
}

.project-card:hover {
    border-color: #00c8ff;
    transform: translateY(-5px);
}

.status {
    display: inline-block;
    margin-top: 15px;
    color: #70ddff;
    font-size: 12px;
}

footer {
    text-align: center;
    padding: 30px;
    color: #8492a9;
    border-top: 1px solid #202b43;
}

@media (max-width: 650px) {
    .navbar {
        flex-wrap: wrap;
    }

    .menu-toggle {
        display: block;
        background: transparent;
        color: white;
        border: 1px solid #31415d;
        padding: 7px 12px;
        border-radius: 6px;
        font-size: 20px;
    }

    .nav-links {
        display: none;
        flex-direction: column;
        width: 100%;
        padding: 15px 0;
    }

    .nav-links.active {
        display: flex;
    }

    .hero {
        padding: 75px 7%;
    }

    .section {
        padding: 55px 7%;
    }
}
/* FUTURISTIC ANIMATIONS */

.btn {
    box-shadow: 0 0 15px rgba(0, 191, 255, 0.25);
    transition: 0.3s ease;
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 25px rgba(0, 191, 255, 0.65);
}

.logo span {
    text-shadow: 0 0 12px rgba(0, 200, 255, 0.6);
}

.hero .tag,
.hero h1,
.hero .intro,
.hero .btn {
    animation: appear 0.9s ease both;
}

.hero h1 {
    animation-delay: 0.15s;
}

.hero .intro {
    animation-delay: 0.3s;
}

.hero .btn {
    animation-delay: 0.45s;
}

.project-card {
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
}

.project-card:hover {
    box-shadow: 0 0 22px rgba(0, 200, 255, 0.15);
}

::selection {
    background: #00c8ff;
    color: #080b16;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}/* PERSONAL PROFILE */

.profile-card {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 25px;
    padding: 30px;
    background: linear-gradient(135deg, #111a2b, #172e48);
    border: 1px solid #245078;
    border-radius: 18px;
    box-shadow: 0 0 25px rgba(0, 200, 255, 0.08);
}

.profile-avatar {
    min-width: 110px;
    height: 110px;
    display: grid;
    place-items: center;
    border: 2px solid #00c8ff;
    border-radius: 50%;
    background: #080b16;
    font-size: 48px;
}

.profile-info h2 {
    margin-bottom: 5px;
}

.profile-info h3 {
    color: #00c8ff;
    font-size: 16px;
    margin-bottom: 12px;
}

.profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.profile-tags span {
    padding: 6px 12px;
    border-radius: 20px;
    background: #0b2940;
    border: 1px solid #245078;
    color: #70ddff;
    font-size: 12px;
}

.career-goal {
    margin-top: 20px;
}

@media (max-width: 600px) {
    .profile-card {
        flex-direction: column;
        align-items: flex-start;
        padding: 22px;
    }
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
}
